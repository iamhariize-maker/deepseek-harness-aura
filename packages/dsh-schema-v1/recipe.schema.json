{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aura local workflow recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "metadata",
    "nodes",
    "edges",
    "privacy_rules",
    "estimate"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kys_status",
        "role_distribution"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kys_status": {
          "const": "pending"
        },
        "role_distribution": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/definitions/role"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,60}$"
          },
          "type": {
            "const": "agent_node"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "reasoning_effort",
              "tools"
            ],
            "properties": {
              "role": {
                "$ref": "#/definitions/role"
              },
              "reasoning_effort": {
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max",
                  "ultra"
                ]
              },
              "tools": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "terminal",
                    "web_search",
                    "patch",
                    "mcp"
                  ]
                }
              },
              "model_source": { "enum": ["auto", "manual"] },
              "model": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "id"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "privacy_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zdr_enabled",
        "redaction_level"
      ],
      "properties": {
        "zdr_enabled": {
          "const": false
        },
        "redaction_level": {
          "const": "strict"
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string",
          "maxLength": 8000
        }
      }
    }
  },
  "definitions": {
    "role": {
      "enum": [
        "Orchestrator",
        "Scout",
        "Implementer",
        "Reviewer",
        "Verifier"
      ]
    }
  }
}
