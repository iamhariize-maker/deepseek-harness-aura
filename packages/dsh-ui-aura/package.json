{
  "name": "dsh-ui-aura",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Model-assigned workflows, reusable notes, live activity and whole-interface themes for DeepSeek Harness web.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "sessions",
        "slots",
        "locale",
        "remote",
        "remote.skills",
        "remote.session",
        "theme"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamhariize-maker/deepseek-harness-aura.git"
  }
}
