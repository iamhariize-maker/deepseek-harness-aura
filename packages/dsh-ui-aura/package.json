{
  "name": "dsh-ui-aura",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamhariize-maker/deepseek-harness-aura.git"
  },
  "files": [
    "lib/",
    "scripts/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-bootstrap.mjs",
    "test": "node scripts/test-aura.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "deepseek-harness-aura": "file:../.."
  },
  "type": "module",
  "description": "Aura Studio for DeepSeek Harness: visual workflow pipelines, model routing, local file context and artisan UI controls.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "sessions",
        "slots",
        "locale",
        "remote",
        "remote.skills",
        "remote.session",
        "theme",
        "conversation",
        "settingsScope"
      ]
    }
  }
}
